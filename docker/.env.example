# Copy to .env and fill in. This file holds every secret; .env is gitignored.

# --- Web UI login (HTTP Basic) -------------------------------------------
NVR_USER=admin
NVR_PASS=change-me

# --- Camera passwords, referenced as ${VAR} from config/cameras.yml -------
# One per camera. Names are yours; they just have to match cameras.yml.
GARAGE_PASS=
DRIVEWAY_PASS=

# --- Storage --------------------------------------------------------------
# Where recordings, clips and the event database live. Point this at a real
# disk -- 1080p at 3 Mbps is roughly 32 GB per camera per day.
DATA_DIR=./data

# --- Listener -------------------------------------------------------------
# Loopback only by default. Use 0.0.0.0 ONLY if the host is on a trusted
# network or behind Tailscale.
BIND_ADDR=127.0.0.1
WEB_PORT=8080
