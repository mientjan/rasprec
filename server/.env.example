# Copy to .env and fill in. This file holds every secret; .env is gitignored.

# --- Administrator (public session mode settings below) -----------------
NVR_USER=admin
NVR_PASS=

# --- Camera passwords, referenced as ${VAR} from config/cameras.yml -------
# One per camera. Names are yours; they just have to match cameras.yml.
GARAGE_PASS=
DRIVEWAY_PASS=

# --- Storage --------------------------------------------------------------
# Where recordings, clips and the event database live. Point this at a real
# disk -- 1080p at 3 Mbps is roughly 32 GB per camera per day.
DATA_DIR=./data

# --- Listener -------------------------------------------------------------
# Loopback only by default. Use 0.0.0.0 ONLY if the host is on a trusted
# network or behind Tailscale.
BIND_ADDR=127.0.0.1
WEB_PORT=8080

# --- Small-installation resource budgets (tune for camera count/resolution) ---
NVR_CLIP_WORKERS=2
NVR_CLIP_QUEUE_SIZE=32
NVR_MEMORY_LIMIT=1g
NVR_CPUS=2.0
MTX_MEMORY_LIMIT=1g
MTX_CPUS=2.0
CONFIG_MEMORY_LIMIT=256m
CONFIG_CPUS=1.0

# New public deployments MUST use session auth and HTTPS.
# Private local installs use basic; AWS forces session and requires the hash below.
NVR_AUTH_MODE=basic
NVR_PUBLIC_ORIGIN=https://cameras.example.com
# Generate privately with: python -m nvr.password
# Single-quote the hash in .env so Compose preserves dollar signs.
NVR_PASSWORD_HASH=''

# AWS website and TLS-only RTMPS ingest share this hostname.
NVR_DOMAIN=cameras.example.com
NVR_ACME_EMAIL=operator@example.com
# Generate one different token per camera with secrets.token_urlsafe(32).
# These values belong only in private runtime files; never commit real tokens.
GARAGE_PUBLISH_TOKEN=
# Must match the Compose network's NVR container address.
NVR_INTERNAL_READER_IP=172.30.88.10
NVR_NETWORK_SUBNET=172.30.88.0/24
