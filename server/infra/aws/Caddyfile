{$NVR_DOMAIN} {
    header Strict-Transport-Security "max-age=31536000"
    request_body {
        max_size 8KB
    }
    reverse_proxy nvr:8080
}

# Certificate challenge for RTMPS. The website still has Caddy-managed HTTPS.
http://{$NVR_DOMAIN} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/acme
        file_server
    }
    handle {
        redir https://{$NVR_DOMAIN}{uri} permanent
    }
}
